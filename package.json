{
  "name": "desimod-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered multilingual moderation for Indian and Bangladeshi subreddits using Devvit + Gemini + Redis.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "devvit playtest",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@devvit/public-api": "latest",
    "@google/generative-ai": "latest",
    "bottleneck": "latest",
    "ioredis": "latest",
    "pino": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
